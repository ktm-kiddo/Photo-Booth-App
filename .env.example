# =============================================================================
#  Photo booth settings
# =============================================================================
#  Edit the Pi's copy from your Mac with:     ./deploy.sh config
#  (saving restarts the booth automatically)
#
#  - Lines starting with # are comments and are ignored.
#  - Leave a value blank (or delete the line) to use the built-in default.
#  - This file holds your Gmail app password. The Pi's copy is never
#    overwritten by deploys and never leaves the Pi.
# =============================================================================


# --- Web server --------------------------------------------------------------
# 0.0.0.0 = accept connections from other devices on the Wi-Fi (the iPad).
HOST=0.0.0.0
PORT=8000

# The admin page: http://photobooth.local:8001 (user name: admin).
# The first ./deploy.sh fills in a random password; change it here if you like.
ADMIN_PORT=8001
ADMIN_PASSWORD=

# How much detail to write to the log: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO


# --- Camera ------------------------------------------------------------------
# Which webcam to use.
#   auto         = the first USB webcam found (recommended)
#   0, 1, 2 ...  = /dev/video0, /dev/video1, ...
CAMERA_DEVICE=auto

# Capture resolution. The camera runs at this size all the time and photos
# are cut from these frames. Your C930e does 1920x1080 at up to 30 fps; 24 is
# plenty for the 20 fps preview and keeps the Pi cooler.
CAMERA_WIDTH=1920
CAMERA_HEIGHT=1080
CAMERA_FPS=24

# Flip everything left-to-right like a mirror.
#   false = text (signs, T-shirts) reads the right way round
#   true  = feels like a mirror when posing, but text is backwards
# Applies to the preview and the photos, so they always match.
MIRROR=false


# --- Live preview (what the iPad shows) --------------------------------------
# Width in pixels of the preview sent to the iPad. Bigger = sharper but more
# work for the Pi and the Wi-Fi.
PREVIEW_WIDTH=800

# Maximum preview frames per second.
PREVIEW_FPS=20

# JPEG quality of preview frames, 1-100.
PREVIEW_JPEG_QUALITY=75


# --- Timers (seconds) ----------------------------------------------------------
# After Start, guests get this long to choose a filter and frame (or tap Go).
# Then the photos start anyway.
STYLE_TIMEOUT_SECONDS=10

# Countdown before the first photo.
COUNTDOWN_SECONDS=3

# Time between the photos (a countdown shows it).
BETWEEN_SHOTS_SECONDS=3

# Review screen: return to the start screen after this long without a touch.
REVIEW_TIMEOUT_SECONDS=60

# Email keyboard: give up and close it after this long without typing.
EMAIL_TIMEOUT_SECONDS=90


# --- Sound -------------------------------------------------------------------
# Countdown beeps and shutter sound from the iPad's speaker.
SOUND_ENABLED=true


# --- Photo strip -------------------------------------------------------------
# Text printed at the bottom of every strip, e.g. "Sam & Alex".
STRIP_TITLE=Photo Booth

# Date line under the title (Python date format). Leave blank for no date.
#   %d %B %Y -> 02 October 2026      %d.%m.%Y -> 02.10.2026
STRIP_DATE_FORMAT=%d %B %Y

# Starting design for every strip. Guests can pick another on the review
# screen. One of: classic, midnight, film, blush, elegant, retro, party, doodle
STRIP_THEME=classic

# Let guests type their own text for the bottom of the strip.
ALLOW_CUSTOM_CAPTION=true


# --- Printing (CUPS) ---------------------------------------------------------
# Show the Print button. Turn on once a printer is set up (see README).
PRINT_ENABLED=false

# CUPS printer name (see: lpstat -p). Blank = the default printer.
PRINTER_NAME=

# Extra options passed to the lp command.
PRINT_OPTIONS=-o media=4x6 -o fit-to-page

# How many prints one group can make from one strip.
PRINT_MAX_PER_SESSION=2


# --- Email (Gmail) ----------------------------------------------------------
# Show the Email button on the review screen. It also stays hidden until the
# address and app password below are filled in.
EMAIL_ENABLED=true

# The Gmail account the booth sends from, and its app password
# (see README: "Email setup"). Spaces in the app password don't matter.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Email design: classic, minimal, bold or elegant. Preview them on the
# admin page (http://photobooth.local:8001).
EMAIL_TEMPLATE=minimal

# Sender name, subject and message. {title} = STRIP_TITLE, {date} = the date.
EMAIL_FROM_NAME=Photo Booth
EMAIL_SUBJECT=Your photos from {title}
EMAIL_MESSAGE=Thank you for visiting the TBS photo booth!


# --- Storage -----------------------------------------------------------------
# Folder on the Pi where every photo and strip is saved.
DATA_DIR=data
